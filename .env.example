# =============================================================================
# STOVE PROJECT — Environment Variables Example
# Copie para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL — local Docker (padrão para desenvolvimento)
# Para usar Neon Cloud, substitua com as credenciais reais.
# ---------------------------------------------------------------------------
PGHOST=postgres
PGDATABASE=stovedb
PGUSER=stove
PGPASSWORD=stove
PGSSLMODE=disable
PGCHANNELBINDING=disable

# Neon Cloud (alternativa em produção):
# PGHOST=ep-xxxxxxxx-pooler.<region>.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=<senha-do-banco>
# PGSSLMODE=require
# PGCHANNELBINDING=require

# ---------------------------------------------------------------------------
# MQTT (HiveMQ Cloud)
# ---------------------------------------------------------------------------
MQTT_HOST=<seu-cluster>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=gaia-backend
MQTT_PASSWORD=<senha-do-usuario-mqtt>
MQTT_USE_TLS=true
MQTT_CLIENT_ID=gaia-backend
MQTT_TOPIC_PREFIX=gaia

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<sua-chave-gemini>
APP_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
ML_INFERENCE_PORT=8001
# Em desenvolvimento local (sem Docker):
ML_INFERENCE_URL=http://localhost:8001
# Em Docker (substituído automaticamente no docker-compose):
# ML_INFERENCE_URL=http://ml-inference:8001

# ---------------------------------------------------------------------------
# Kaggle (para download do dataset PlantVillage no módulo ML)
# ---------------------------------------------------------------------------
KAGGLE_USERNAME=<seu-usuario-kaggle>
KAGGLE_KEY=<sua-api-key-kaggle>
