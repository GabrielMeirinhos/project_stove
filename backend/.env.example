# Template de configuração — copie este arquivo para `.env` e preencha
# os valores. O arquivo `.env` real NÃO deve ser commitado (já está no
# .gitignore na raiz do projeto).

# ---------------------------------------------------------------------------
# PostgreSQL (Neon)
# ---------------------------------------------------------------------------
PGHOST=ep-xxxxxxxx-pooler.<region>.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=<senha-do-banco>
PGSSLMODE=require
PGCHANNELBINDING=require

# ---------------------------------------------------------------------------
# HiveMQ Cloud (MQTT)
# ---------------------------------------------------------------------------
MQTT_HOST=<seu-cluster>.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=gaia-backend
MQTT_PASSWORD=<senha-do-usuario-mqtt>
MQTT_USE_TLS=true
MQTT_CLIENT_ID=gaia-backend
MQTT_TOPIC_PREFIX=gaia
