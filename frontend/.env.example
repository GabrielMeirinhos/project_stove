# Front local environment example.
# Copie para .env e ajuste conforme o broker usado pelo backend.

# MQTT do backend
MQTT_HOST=bdffc9a5bf6e4bf28591393206fc27e0.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=gaia-backend
MQTT_PASSWORD=<senha-do-broker>
MQTT_USE_TLS=true
MQTT_TOPIC_PREFIX=gaia

# Opcionais para este front
MQTT_URL=
MQTT_TOPIC=
MQTT_SIM_TOPIC=

# Gemini / AI Studio
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
